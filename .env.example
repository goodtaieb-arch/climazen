# Copier vers .env.local (local) et Vercel → Environment Variables (prod)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Modèle IA par défaut (si la société ne force pas un modèle)
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-sonnet-4-5
# GEMINI_MODEL=gemini-2.5-flash
# Les clés API sont collées par le gérant dans Mon entreprise (pas ici).

# E-mails signature à distance (depuis ClimaZEN, pas la boîte du tech)
# 1) Compte Resend https://resend.com → API Key
# 2) Vérifier le domaine climazen.fr (DNS)
# 3) Vercel → Environment Variables → Production
# RESEND_API_KEY=re_...
# MAIL_FROM=ClimaZEN <contact@climazen.fr>

# Tickets portail client → OT + e-mail bureau (/api/process-client-ticket)
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   (Settings → API → service_role — jamais côté client)
# (clé IA société : Mon entreprise — OpenAI / Claude / Gemini)

# Vocabulaire technique IA (Supabase) — exécuter supabase/ai-vocabulary.sql
# Puis supabase/ai-org-openai.sql + supabase/ai-org-providers.sql (clés multi-IA)
# Puis supabase/ai-telephony-security.sql (numéro Lola + audit sécurité)

# Téléphonie Lola — le GÉRANT achète le numéro (Twilio / Vonage / Plivo)
# Webhook fixe ClimaZEN : https://climazen.fr/api/telephony-inbound
# Guide : docs/TELEPHONIE-LOLA.md
# TWILIO_AUTH_TOKEN=…   (optionnel — validation webhooks Twilio côté Vercel)

